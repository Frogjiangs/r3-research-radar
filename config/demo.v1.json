{
  "schema_version": "1.1",
  "workspace_root": ".",
  "demo_mode": true,
  "profile_id": "r3-deterministic-demo",
  "profile_version": 1,
  "name": "R3 Deterministic Evidence Demo",
  "research_question": "How can a research radar connect papers and repositories to a decision without hiding uncertainty?",
  "decision_scope": "Inspect two clearly synthetic fixtures and exercise the evidence, feedback, export, and decision workflow without network or model calls.",
  "languages": {
    "academic_primary": ["en"],
    "secondary_reference": ["zh"]
  },
  "time_policy": {
    "technical_from_year": 2023,
    "priority_from_year": 2025,
    "older_foundational_lane": true
  },
  "frontier_ratio": 0.5,
  "mature_ratio": 0.5,
  "run": {
    "max_runtime_seconds": 300,
    "weekly_display_min": 1,
    "weekly_display_max": 5,
    "important_min": 1,
    "important_max": 3,
    "must_read_min": 1,
    "must_read_max": 2,
    "resume_incomplete": true,
    "max_content_items_per_invocation": 5,
    "max_transfer_bytes_per_invocation": 1048576,
    "minimum_free_disk_bytes": 1048576
  },
  "sources": {
    "openalex": {
      "enabled": true,
      "delay_seconds": 1.1,
      "page_size": 5,
      "max_results_per_query": 5
    },
    "arxiv": {
      "enabled": true,
      "delay_seconds": 3.3,
      "page_size": 5,
      "max_results_per_query": 5
    },
    "github": {
      "enabled": true,
      "delay_seconds": 6.5,
      "page_size": 5,
      "max_results_per_query": 5
    }
  },
  "hosted_search": {
    "enabled": false,
    "provider": "codex_cli",
    "mode": "supplementary",
    "max_queries_per_run": 1,
    "timeout_seconds": 60,
    "sandbox": "read-only",
    "live_search": false,
    "prompt_version": "r3-hosted-search-v1",
    "query_ids": ["q01"],
    "official_domains": ["arxiv.org", "github.com"]
  },
  "queries": [
    {
      "id": "q01",
      "lane": "core",
      "sources": ["openalex", "arxiv"],
      "query": "synthetic demo paper fixture"
    },
    {
      "id": "g01",
      "lane": "code",
      "sources": ["github"],
      "query": "synthetic demo repository fixture"
    }
  ],
  "admission": {
    "require_title": true,
    "exclude_retracted": true,
    "exclude_github_archived": true,
    "exclude_github_forks": false,
    "no_semantic_prefilter": true
  },
  "documents": {
    "max_download_bytes": 1048576,
    "max_repository_archive_bytes": 1048576,
    "max_repository_uncompressed_bytes": 2097152,
    "max_repository_text_bytes": 1048576,
    "max_single_text_file_bytes": 524288,
    "repository_corpus": {
      "mode": "core_plus_sampled_aux_v1",
      "max_selected_text_bytes": 524288,
      "max_auxiliary_text_bytes": 65536
    },
    "chunk_characters": 6500,
    "chunk_overlap_characters": 350
  },
  "pdf_parser": {
    "backend": "pypdf_worker",
    "policy_version": "r3-pdf-text-v1",
    "wall_timeout_seconds": 120,
    "cpu_time_seconds": 90,
    "memory_limit_bytes": 1073741824,
    "max_input_bytes": 1048576,
    "max_pages": 20,
    "max_output_characters": 100000,
    "max_result_bytes": 1048576
  },
  "analysis": {
    "primary_provider": "codex_cli",
    "prompt_version": "r3-deep-read-v5",
    "batch_chunk_count": 6,
    "synthesis_group_max_items": 24,
    "synthesis_input_character_budget": 60000,
    "cleanup_margin_seconds": 30,
    "minimum_model_call_seconds": 30,
    "max_parallel_batches": 1,
    "budget_planning": {
      "retry_reserve_invocations": 0
    },
    "output_detail": "concise_evidence",
    "budgets": {
      "max_invocations_per_run": 1,
      "max_invocations_per_task": 1,
      "max_input_tokens_per_run": 1,
      "max_input_tokens_per_task": 1,
      "max_output_tokens_per_run": 1,
      "max_output_tokens_per_task": 1
    },
    "codex_cli": {
      "timeout_seconds": 60,
      "sandbox": "read-only",
      "ephemeral": true,
      "ignore_user_config": true,
      "ignore_rules": true,
      "model": "",
      "reasoning_effort": "low"
    },
    "fallback_provider": "llama_cpp",
    "fallback_only": true,
    "llama_cpp": {
      "base_url": "http://127.0.0.1:18130/v1",
      "model": "demo-disabled",
      "api_key_env": "R3_RADAR_LLM_API_KEY",
      "timeout_seconds": 60,
      "temperature": 0.1,
      "chunk_max_tokens": 100,
      "synthesis_max_tokens": 100,
      "managed_server": {
        "enabled": false,
        "executable": "",
        "model_path": "",
        "host": "127.0.0.1",
        "port": 18130,
        "devices": [],
        "split_mode": "layer",
        "tensor_split": "",
        "context": 1024,
        "batch_size": 32
      }
    }
  },
  "paths": {
    "data": "data",
    "literature": "literature",
    "outputs": "outputs"
  }
}

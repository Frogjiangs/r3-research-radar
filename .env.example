# Copy only the variables you need into your local environment.
# Never commit a populated .env file.

# Required for OpenAlex API collection.
OPENALEX_API_KEY=

# Optional: raises GitHub REST API limits. Use a least-privilege token.
GITHUB_TOKEN=

# Optional: contact address used in responsible provider requests.
R3_RADAR_CONTACT_EMAIL=you@example.com

# Optional: overrides the default local configuration path.
R3_RADAR_CONFIG=path/to/r3.config.json

# Optional: credential for a configured OpenAI-compatible fallback endpoint.
# The default local llama.cpp endpoint normally does not require a real key.
R3_RADAR_LLM_API_KEY=

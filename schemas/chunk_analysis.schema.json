{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "content_sha256", "chunks"],
  "properties": {
    "candidate_id": {"type": "integer"},
    "content_sha256": {"type": "string"},
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_index",
          "coverage_confirmed",
          "summary_zh",
          "methods",
          "evaluation",
          "limitations",
          "r3_connections",
          "evidence",
          "uncertainties"
        ],
        "properties": {
          "chunk_index": {"type": "integer"},
          "coverage_confirmed": {"type": "boolean"},
          "summary_zh": {"type": "string", "minLength": 1},
          "methods": {"type": "array", "items": {"type": "string"}},
          "evaluation": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "r3_connections": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor", "claim_zh", "excerpt"],
              "properties": {
                "anchor": {"type": "string", "minLength": 1},
                "claim_zh": {"type": "string", "minLength": 1},
                "excerpt": {"type": "string", "minLength": 1}
              }
            }
          },
          "uncertainties": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

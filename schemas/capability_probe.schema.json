{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "capability", "evidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "unavailable"]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r3radar.local/schemas/known_answer_evaluation_receipt_v1.schema.json",
  "title": "R3 Known-Answer Evaluation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "known_answer_set", "candidate_run", "evaluation", "metrics",
    "matches", "baselines", "comparisons", "warnings", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "r3/known-answer-evaluation-receipt/v1"},
    "known_answer_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_id", "set_sha256", "split", "split_assignment_sha256", "item_count"],
      "properties": {
        "set_id": {"type": "string", "minLength": 1},
        "set_sha256": {"$ref": "#/$defs/sha256"},
        "split": {"enum": ["development", "evaluation"]},
        "split_assignment_sha256": {"$ref": "#/$defs/sha256"},
        "item_count": {"type": "integer", "minimum": 1}
      }
    },
    "candidate_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_run_id", "candidate_pool_id", "candidate_pool_frozen_at",
        "candidate_source_artifact_ids", "origin_known_answer_set_ids",
        "known_answer_splits_accessed_before_run", "ranking_method"
      ],
      "properties": {
        "candidate_run_id": {"type": "string", "minLength": 1},
        "candidate_pool_id": {"type": "string", "minLength": 1},
        "candidate_pool_frozen_at": {"type": "string", "format": "date-time"},
        "candidate_source_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "origin_known_answer_set_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "known_answer_splits_accessed_before_run": {"type": "array", "uniqueItems": true, "items": {"enum": ["development", "evaluation"]}},
        "ranking_method": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_identity", "evaluated_at", "identity_matching",
        "partial_judgment_policy", "market_or_recommendation_quality_claim"
      ],
      "properties": {
        "evaluator_identity": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "identity_matching": {"const": "exact_canonical_identity_and_required_version"},
        "partial_judgment_policy": {"const": "metric_unknown_when_returned_positions_are_unjudged"},
        "market_or_recommendation_quality_claim": {"const": false}
      }
    },
    "metrics": {"type": "object"},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "status", "candidate_id", "rank"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["exact", "identity_missing", "version_unknown", "version_conflict", "unmatched"]},
          "candidate_id": {"type": ["string", "null"]},
          "rank": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "baselines": {"type": "object"},
    "comparisons": {"type": "object"},
    "warnings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
